{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/meta/events/process-queue",
      "schedule": "0 0 * * *"
    }
  ],
  "env": {
    "ENABLE_WORKERS": "false"
  }
}
